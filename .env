# 镜像内容与 nvcr.io/nvidia/ai-dynamo/sglang-runtime:1.5.1 一致（Dynamo 1.5.1 + SGLang 0.5.18）
SGLANG_IMAGE=registry.cn-hangzhou.aliyuncs.com/ripper/sglang-runtime:latest
MODEL_DIR=/data/nvme0/glm-5.3
# JIT 编译缓存，避免每次重启重新编译
CACHE_DIR=/data/nvme0/glm53-cache
# 网关机器（10.10.93.89）上的 etcd
ETCD_ENDPOINTS=http://10.10.93.89:2379
